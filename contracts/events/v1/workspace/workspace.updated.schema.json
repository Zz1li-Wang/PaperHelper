{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-helper.local/contracts/events/v1/workspace/workspace.updated.schema.json",
  "title": "Workspace updated event v1",
  "allOf": [
    {
      "$ref": "https://paper-helper.local/contracts/events/v1/envelope.schema.json"
    },
    {
      "properties": {
        "message_type": {"const": "workspace.updated"},
        "message_kind": {"const": "event"},
        "schema_version": {"const": 1},
        "workspace_id": {"type": "string", "format": "uuid"},
        "aggregate_type": {"const": "workspace"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "payload": {
          "type": "object",
          "required": ["changes"],
          "properties": {
            "changes": {
              "description": "Only the fields actually changed by this command (design §7.3).",
              "type": "object",
              "minProperties": 1,
              "properties": {
                "title": {"type": "string"},
                "description": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                "visibility": {"enum": ["private", "shared", "public"]}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
